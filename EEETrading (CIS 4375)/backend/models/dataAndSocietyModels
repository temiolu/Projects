    organizationID: {
        type: Array,
        ref: 'orgData',
        required: true
    },
    userID:{
        type: String,
        ref: 'userData'
    },
    studentInformation: {
        cityOrigin:{type:String},
        primaryLanguage:{type:String},
        otherLanguages:{type:String,},
        languagePreference:{type:String, required: true},
        pronouns:{type: Array},
        otherPronouns:{type:String,},
        commentsByStaff:{type:String,},
        issuesConcernsTriggers:{type:String,},
        enrolledUHInfo: {
            uhStatus:{type:String, required: true},
            uhEmail:{type:String,},
            peopleSoftID:{type:String,},
            expectedGraduationYear:{type:String,},
            livingOnCampus:{type:String,}, //true = living on campus, false = not living on campus
            honorsCollegeStatus:{type:String,},
            honorsCollegeAffiliatedStatus:{type:String,},
            honorsCollegeAffiliatedHow:{type:String,},
            majors:{type:Array,},
            honorsMinors:{type:Array,},
            otherMinors:{type:Array,}
        },
        hichInfo:{
            hichStatus:{type:String,},
            hichHistoryStatus:{type:String,},
        },
        communityServiceInfo:{
            serviceStatus:{type:String, required: true},
            serviceHistoryDesc:{type:String,},
            serviceOrgsOutsideUH:{type:String,}
        },
        graduateProfessionalSchool:{
            programGradProStatus:{type:String, required: true},
            programGradProType:{type:Array,},
            phDTextbox:{type:String,},
            masterTextbox:{type:String,},
            otherTextbox:{type:String,},
        },
        specializedDegCert:{
            specializedDegCertStatus:{type:String, required: true},
            specializedDegCertType:{type:Array,},
            professionalDesignOther:{type:String,}
