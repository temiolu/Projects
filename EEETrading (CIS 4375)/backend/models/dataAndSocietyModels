//collection for exitFormData
const exitFormDataSchema = new Schema ({
    _id:{type: String, default: uuid.v1},
    organizationID: {
        type: Array,
        ref: 'orgData',
        required: true
    },
    userID:{
        type: String,
        ref: 'userData'
    },
    semester: {
        type: String,
        ref:'semesterData'
    },
    experienceID: {
        type: String,
        ref:'experienceData'
    },
    goalSettingFormID:{
        type:String,
        ref:'goalSettingFormData'
    },
    //need to make section for new input information?
    exitForm:{
        ///Results are "progress i made to this is x, progress i made was because of this course"
        progressMade:{
            aspirationOneProgressResults:"",
            aspirationTwoProgressResults:"",
            aspirationThreeProgressResults:"",
            aspirationOneExperienceConnection:"",
            aspirationTwoExperienceConnection:"",
            aspirationThreeExperienceConnection:"",
            goalOneProgressResults:"",
            goalTwoProgressResults:"",
            goalThreeProgressResults:"",
            goalFourProgressResults:"",
            goalFiveProgressResults:"",
            goalOneExperienceConnection:"",
            goalTwoExperienceConnection:"",
            goalThreeExperienceConnection:"",
            goalFourExperienceConnection:"",
            goalFiveExperienceConnection:"",
        },
        //section to describe obstacles and how it was overcome
        goalIssues:{
            goals:{type:Array,},
            issuesDescription:{type:String,},
        },
        //array that includes which activities contributed towards the goals
        activitiesContribution:{
            goalOneContributions:{type:Array,},
            goalTwoContributions:{type:Array,},
            goalThreeContributions:{type:Array,},
            goalFourContributions:{type:Array,},
            goalFiveContributions:{type:Array,},
            noContributions:{type:Array},
        },
        //how experience contributed to goals, net promoter question
        experienceContributions:{type:String,},
        //likliehood of doing certain actions based on the experience taken
        likelihoodOf:{
            enrollAnotherCourse:{type:String,},
            completeMinor:{type:String,},
            recommendCourse:{type:String,},
            pursueCareer:{type:String,},
        },
        //general growth goals and the results after experience
        generalGrowth:{
            problemSolving:{type:String,},
            effectiveCommunication:{type:String,},
            teamwork:{type:String,},
            culturalHumility:{type:String,},
            ethicalDecisionMaking:{type:String,},
            professionalResponsibility:{type:String,},
        },
        //general open ended
        openEnded:{
            biggestLessons:{type:String,},
            supportOthers:{type:String,},
            comments:{type:String,},
        }

    }
}, {
    collection: 'exitFormData',
    timestamps: true
});

// create models from mongoose schemas
const semesterdata = mongoose.model('semesterData', semesterDataSchema);
const experiencedata = mongoose.model('experienceData', experienceDataSchema);
const activitydata = mongoose.model('activityData', activityDataSchema);
const goalsettingformdata = mongoose.model('goalSettingFormData', goalSettingFormDataSchema);
const studententryformdata = mongoose.model('studentEntryFormData', studentEntryFormDataSchema);
const exitformdata = mongoose.model('exitFormData', exitFormDataSchema);
// package the models in an object to export 
module.exports = { semesterdata, experiencedata, activitydata, goalsettingformdata, studententryformdata, exitformdata }

