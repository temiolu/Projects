const uuid = require('uuid');
const mongoose = require('mongoose');
const Schema = mongoose.Schema;

//collection for semestersDataSchema
const semesterDataSchema = new Schema ({
    _id:{type: String, default: uuid.v1},
    semesterName: {
        type: String,
        required: true
    },
    semesterStartDate:{
        type:Date,
        required:true
    },
    semesterEndDate:{
        type:Date,
        required:true
    },
    experiences:{
        type:Array,
        ref: 'experienceData'
    },
    semesterStatus:{
        //true = active, false = inactive
        type:Boolean,
        required:true,
        default:true
    }
}, {
    collection: 'semesterData',
    timestamps: true
});

//collection for experienceDataSchema
const experienceDataSchema = new Schema ({
    _id:{type: String, default: uuid.v1},
    experienceCategory: {
        type: String,
        required: true
    },
    experienceName: {
        type: String,
        required: true
    },
    activities:{
        type: Array,
        ref: 'activityData'
    },
    experienceStatus:{
        //true = active, false = inactive
        type:Boolean,
        required: true,
        default: true
    }
}, {
    collection: 'experienceData',
    timestamps: true
});

//collection for activityDataSchema
const activityDataSchema = new Schema ({
    _id:{type: String, default: uuid.v1},
    activityName: {
        type: String,
        required: true
    },
    activityStatus:{
        //true = active, false = inactive
        type:Boolean,
        required:true,
        default: true
    }
}, {
    collection: 'activityData',
    timestamps: true
});

//collection for goalSettingFormData
const goalSettingFormDataSchema = new Schema ({
    _id:{type: String, default: uuid.v1},
    organizationID: {
        type: Array,
        ref: 'orgData',
        required: true
    },
    userID:{
        type: String,
        ref: 'userData'
    },
    semester: {
        type: String,
        ref:'semesterData'
    },
    experienceID: {
        type: String,
        ref:'experienceData'
    },
    goalForm: {
        communityEngagement: {
            communityEngagementExperiences: { type: Array },
            communityEngagementExperiencesOther: { type: String },
            previousEngagementExperiences: { type: Array },
            previousEngagementExperiencesOther: { type: String },
            engagementActivitiesTools: { type: Array },
            engagementActivitiesToolOther: { type: String },
        },
        researchExperience: {
            currentResearchExperience: { type: Array },
            currentResearchExperienceOther: { type: String },
            previousResearchExperience: { type: Array },
            previousResearchExperienceOther: { type: String },
            familiarTools: { type: Array },
            familiarToolOther: { type: String },
            interestResearchService: { type: Array },
            interestResearchServiceOther: { type: String },
            leadershipOption: { type: String }
        },
        growthGoal: {
            problemSolvingGoal: { type: String },
            effectiveCommunicationGoal: { type: String },
            teamworkGoal: { type: String },
            culturalHumilityGoal: { type: String },
            ethicalDecisionMakingGoal: { type: String },
            professionalResponsibilityGoal: { type: String },
        },
        aspirations:{
            aspirationOne:{type:String},
            aspirationTwo:{type:String},
            aspirationThree:{type:String},
        },
        goals:{
            goalOne:{type:String},
            goalTwo:{type:String},
            goalThree:{type:String},
            goalFour:{type:String},
            goalFive:{type:String},
        }
    },
  }, {
    collection: 'goalSettingFormData',
    timestamps: true
});

//collection for studentEntryFormData
const studentEntryFormDataSchema = new Schema ({
